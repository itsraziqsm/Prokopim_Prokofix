{
  "name": "super-app-kerja",
  "private": true,
  "description": "Build CSS Tailwind untuk Super App Kerja (Flask). Node hanya dibutuhkan saat mengubah tampilan.",
  "scripts": {
    "build:css": "tailwindcss -i ./app/static/src/input.css -o ./app/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./app/static/src/input.css -o ./app/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.2",
    "tailwindcss": "4.3.2"
  }
}
