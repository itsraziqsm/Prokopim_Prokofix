# Cadangan otomatis Super App Prokopim (dijalankan oleh superapp-cadangan.timer).
# Kata sandi cadangan dibaca dari /etc/superapp/cadangan.env (lihat deploy/README.md, langkah 9).

[Unit]
Description=Cadangan otomatis Super App Prokopim
After=superapp.service

[Service]
Type=oneshot
User=superapp
Group=superapp
WorkingDirectory=/opt/superapp
EnvironmentFile=/etc/superapp/cadangan.env
Environment=SUPERAPP_SERVER=1
ExecStart=/opt/superapp/.venv/bin/flask --app run cadangan buat --jenis lengkap
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/superapp/instance
CapabilityBoundingSet=
